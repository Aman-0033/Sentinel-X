# ==============================================================================
# SENTINEL-X - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with secure credentials.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment (development | staging | production | test)
ENVIRONMENT=development
PROJECT_NAME=Sentinel-X
API_V1_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO

# Application Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 16+)
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=sentinel_x
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://sentinel:replace_with_secure_postgres_password@localhost:5432/sentinel_x

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Authentication & Cryptographic Secrets (Minimum 32 characters in production)
JWT_SECRET=replace_with_secure_jwt_secret_min_32_chars_random
JWT_REFRESH_SECRET=replace_with_secure_jwt_refresh_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Administrative & Security Keys
ADMIN_BOOTSTRAP_SECRET=replace_with_secure_admin_bootstrap_secret_min_32_chars
MODEL_SIGNING_KEY=replace_with_secure_model_signing_key_min_32_chars

# External Threat-Intelligence Provider APIs (Optional, failure-tolerant)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Security & Traffic Controls
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=120

